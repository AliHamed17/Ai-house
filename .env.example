# Copy this file to .env.local and fill in only the values you have.
# Every variable below is optional — the app runs fully in demo/mock mode
# with no keys set at all. Never commit a file containing real secrets.

# --- Live generation master switch -----------------------------------------
# Billed generation stays OFF even when a key below is present, unless this is
# exactly "true". This keeps a key set for the offline generator or local dev
# from turning the public /api/*/generate routes into an unauthenticated,
# credit-spending endpoint. Before enabling this on a publicly reachable
# deployment, put real authentication / quotas in front of those routes.
AI_ALLOW_LIVE=

# --- Nano Banana (Gemini image generation) ---------------------------------
# Server-side only. Get a key from https://aistudio.google.com/apikey
# The google-genai SDK reads either GEMINI_API_KEY or GOOGLE_API_KEY; set one.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Model used for final, high-fidelity, geometry-sensitive interior concepts.
# Defaults to "gemini-3-pro-image-preview" (Nano Banana Pro) if unset; use
# "gemini-2.5-flash-image" for faster/cheaper drafts.
NANO_BANANA_MODEL=gemini-3-pro-image-preview

# --- Higgsfield (image-to-video cinematic clips) ---------------------------
# Server-side only. Get credentials from https://cloud.higgsfield.ai/api-keys
# Preferred: single "KEY_ID:KEY_SECRET" value.
HF_CREDENTIALS=
# Alternative: separate key/secret (used only if HF_CREDENTIALS is unset).
HF_API_KEY=
HF_API_SECRET=

# REQUIRED for live Higgsfield generation: this deployment's real public
# origin (e.g. https://your-house.vercel.app), used to build the source image
# URL Higgsfield fetches from ITS OWN servers. Deliberately NOT derived from
# the incoming request — a caller who controls or spoofs the Host header
# could otherwise redirect that fetch (and this app's billed credits) to a
# server they control. Live generation is refused until this is set.
PUBLIC_ASSET_ORIGIN=

# Endpoint and model are configurable because provider offerings change.
HF_IMAGE2VIDEO_ENDPOINT=/v1/image2video/dop
HF_MODEL=dop-turbo
